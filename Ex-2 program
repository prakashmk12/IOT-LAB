SARVO MOTOR CONTROL BASED ON INPUT FROM IR SENSOR
Aim:
  to control servo motor based on the input from IR sensor using arduino 

#include <Servo.h>

int p = 0;

Servo myServo;

// IR sensor digital output connected to pin 2
const int IR_SENSOR_PIN = 2;

// Servo motor control pin
const int SERVO_PIN = 9;

void setup()
{
  pinMode(IR_SENSOR_PIN, INPUT);

  // Attach the servo to pin 9
  myServo.attach(SERVO_PIN);

  // Initialize servo to 0 degrees
  myServo.write(0);

  // Start serial communication
  Serial.begin(9600);
}

void loop()
{
  // Read the state of the IR sensor
  int sensorState = digitalRead(IR_SENSOR_PIN);

  if (sensorState == HIGH)
  {
    // If the sensor detects an object
    myServo.write(90);

    Serial.println("Object detected! Rotating to 90 degrees.");

    delay(1000);
  }
  else
  {
    // If no object is detected
    myServo.write(0);

    Serial.println("No object detected. Returning to 0 degrees.");

    delay(1000);
  }
}
